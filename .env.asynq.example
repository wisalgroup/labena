# Component-only configuration: add DATABASE_URL before serving the installed modules.
# For the complete application, start with .env.quickstart.example.
APP_ENV=development
# Application config: internal/app/config/config.go is the source of keys and defaults.
# Existing process variables win over dotenv. Empty values use envDefault, when set.
# APP_ENV_FILE selects a required file; set it to an empty process value to skip dotenv.

LOG_CHANNELS=stderr
APP_STARTUP_TIMEOUT=30s
APP_SHUTDOWN_TIMEOUT=45s
APP_CLEANUP_TIMEOUT=10s

MIGRATION_TIMEOUT=5m

DATABASE_NAME=
DATABASE_DRIVER=postgres
DATABASE_URL=
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_PING_TIMEOUT=5s
DATABASE_SLOW_QUERY_THRESHOLD=500ms

HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_HEADER_BYTES=1048576

# Browser access allows all origins by default. Set false to disable CORS.
# Restrict with comma-separated exact origins; no trailing slash.
# Example: HTTP_CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.example.com
# A wildcard origin is allowed only when credentials are disabled. CORS is not CSRF protection.
HTTP_CORS_ENABLED=true
HTTP_CORS_ALLOW_ORIGINS=*
HTTP_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
# Allow any request header, or use a comma-separated list of explicit names.
HTTP_CORS_ALLOW_HEADERS=*
HTTP_CORS_EXPOSE_HEADERS=
HTTP_CORS_ALLOW_CREDENTIALS=false
HTTP_CORS_MAX_AGE=12h

# Optional cache: disabled, memory, database or redis.
CACHE_DRIVER=disabled
CACHE_NAMESPACE=default
CACHE_MAX_ENTRY_BYTES=1048576
CACHE_MEMORY_CAPACITY=10000
CACHE_MEMORY_MAX_BYTES=67108864
CACHE_REDIS_URL=redis://127.0.0.1:6379/0
CACHE_DATABASE_TABLE=cache_entries
CACHE_OPERATION_TIMEOUT=5s

# Optional OTLP HTTP tracing; no collector required while disabled.
TRACING_ENABLED=false
TRACING_TRUST_INCOMING=false
APP_NAME=labena
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLE_RATIO=0.1
TRACING_EXPORT_TIMEOUT=5s
TRACING_SHUTDOWN_TIMEOUT=3s

# Separate Prometheus scrape listener, optional for every long-running role.
METRICS_ENABLED=false
METRICS_ADDRESS=127.0.0.1:9090

# MinIO credentials below are local development fixtures only.
# Named disks are defined in internal/app/config/filesystems.go.
# Only the selected disk opens at startup; disabled opens none.
FILESYSTEM_DISK=disabled
# Per-disk media defaults; direct URLs require public-read access only to public/*.
FILESYSTEM_MINIO_VISIBILITY=public
FILESYSTEM_MINIO_URL_MODE=internal
FILESYSTEM_MINIO_PUBLIC_URL=http://localhost:9000/uploads
MEDIA_BASE_URL=http://localhost:8080/api/v1/media
FILESYSTEM_LOCAL_ROOT=storage/app

FILESYSTEM_S3_BUCKET=
FILESYSTEM_S3_REGION=us-east-1
FILESYSTEM_S3_ENDPOINT=
FILESYSTEM_S3_USE_PATH_STYLE=false
FILESYSTEM_S3_ACCESS_KEY_ID=
FILESYSTEM_S3_SECRET_ACCESS_KEY=
FILESYSTEM_S3_SESSION_TOKEN=

FILESYSTEM_MINIO_BUCKET=uploads
FILESYSTEM_MINIO_REGION=us-east-1
FILESYSTEM_MINIO_ENDPOINT=http://127.0.0.1:9000
FILESYSTEM_MINIO_USE_PATH_STYLE=true
FILESYSTEM_MINIO_ACCESS_KEY_ID=demo
FILESYSTEM_MINIO_SECRET_ACCESS_KEY=local-demo-minio
FILESYSTEM_MINIO_SESSION_TOKEN=

FILESYSTEM_SPACES_BUCKET=
FILESYSTEM_SPACES_REGION=us-east-1
FILESYSTEM_SPACES_ENDPOINT=
FILESYSTEM_SPACES_USE_PATH_STYLE=false
FILESYSTEM_SPACES_ACCESS_KEY_ID=
FILESYSTEM_SPACES_SECRET_ACCESS_KEY=
FILESYSTEM_SPACES_SESSION_TOKEN=

FILESYSTEM_GCS_BUCKET=
FILESYSTEM_GCS_CREDENTIALS_FILE=

FILESYSTEM_AZURE_BUCKET=
FILESYSTEM_AZURE_ENDPOINT=
FILESYSTEM_AZURE_ACCOUNT_NAME=
FILESYSTEM_AZURE_ACCOUNT_KEY=

# Asynq jobs on Redis; Watermill GoChannel local events.
QUEUE_DEFAULT=default
# Optional exact task routes, e.g. identity.welcome.v1=high
QUEUE_ROUTES=
EVENTS_DRIVER=gochannel
QUEUE_REDIS_URL=redis://127.0.0.1:6379/1
QUEUE_DEFAULT_PRIORITY=1
QUEUE_HIGH_PRIORITY=3
QUEUE_CONCURRENCY=4
# Recurring work runs separately with cmd/scheduler; run one per schedule set.

# Optional queue administration and registered CLI command jobs.
# Optional authenticated UI on the existing HTTP server at /admin/queues/
QUEUE_DASHBOARD_ENABLED=false
QUEUE_DASHBOARD_USERNAME=
QUEUE_DASHBOARD_PASSWORD=

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=
MAIL_BRAND_NAME=
MAIL_ACCENT_COLOR="#1D4ED8"
MAIL_LOGO_URL=
MAIL_WEBSITE_URL=https://example.com
MAIL_SUPPORT_EMAIL=support@example.com
MAIL_FOOTER="Account updates, thoughtfully delivered."





PUSH_ENABLED=false
PUSH_EXPO_ACCESS_TOKEN=
PUSH_EXPO_PROJECT_ID=
