# Full local development profile. Fill every blank credential before starting.
# Copy to .env; never commit real credentials. Process environment values win.
# Go owns tuning defaults; complete reference: deployments/configuration.md.
APP_ENV=development
APP_NAME=labena
LOG_CHANNELS=stderr,file,observability

# Optional local viewer at /admin/logs/. Works without the observability channel.
LOG_VIEWER_ENABLED=false
LOG_VIEWER_USERNAME=
LOG_VIEWER_PASSWORD=

# PostgreSQL and Redis exposed by Tilt. Redis databases isolate each capability.
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://demo:local-demo@127.0.0.1:5442/go_modular?sslmode=disable
CACHE_DRIVER=redis
CACHE_REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_REDIS_URL=redis://127.0.0.1:6379/1
EVENTS_DRIVER=gochannel
RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/2

# HTTP admission and dependency readiness. Restrict origins outside local development.
HTTP_DOCS_ENABLED=true
HTTP_CORS_ENABLED=true
HTTP_CORS_ALLOW_ORIGINS=*
HTTP_READINESS_DEPENDENCIES=true
# Comma-separated CIDRs of controlled ingress proxies; empty ignores forwarding headers.
HTTP_TRUSTED_PROXIES=
API_RATE_LIMIT_ENABLED=true

# MinIO development fixture. Other disks remain available through Go configuration.
FILESYSTEM_DISK=minio
# Per-disk media defaults; direct URLs require public-read access only to public/*.
FILESYSTEM_MINIO_VISIBILITY=public
FILESYSTEM_MINIO_URL_MODE=internal
FILESYSTEM_MINIO_PUBLIC_URL=http://localhost:9000/uploads
MEDIA_BASE_URL=http://localhost:8080/api/v1/media
FILESYSTEM_MINIO_ENDPOINT=http://127.0.0.1:9000
FILESYSTEM_MINIO_BUCKET=uploads
FILESYSTEM_MINIO_ACCESS_KEY_ID=demo
FILESYSTEM_MINIO_SECRET_ACCESS_KEY=local-demo-minio

# Recurring work runs separately with cmd/scheduler; run one per schedule set.
QUEUE_DASHBOARD_ENABLED=true
QUEUE_DASHBOARD_USERNAME=operator
QUEUE_DASHBOARD_PASSWORD=

# SMTP delivery and queued mail; the selected server must support STARTTLS.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=
MAIL_BRAND_NAME=
MAIL_ACCENT_COLOR="#1D4ED8"
MAIL_LOGO_URL=
MAIL_WEBSITE_URL=https://example.com
MAIL_SUPPORT_EMAIL=support@example.com
MAIL_FOOTER="Account updates, thoughtfully delivered."

# Passwordless Identity. Generate EACH key independently: openssl rand -base64 32
# Keep keys stable across restarts and shared across replicas.
AUTH_ENABLED=true
AUTH_VERIFICATION_KEY=
AUTH_ACCESS_TOKEN_KEY=
AUTH_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=
# Phone verification is not implemented and stays disabled by its Go default.

# Expo project with enhanced push security enabled.
PUSH_ENABLED=true
PUSH_EXPO_PROJECT_ID=
PUSH_EXPO_ACCESS_TOKEN=

# Tilt forwards Alloy's OTLP listener. Metrics remain local for a host app.
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
METRICS_ENABLED=true
METRICS_ADDRESS=127.0.0.1:9090

# Optional temporary media links; generate an independent 32-byte base64 secret.
MEDIA_SIGNING_KEY=
