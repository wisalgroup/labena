# Local tutorial only. Existing shell variables override these values.
APP_ENV=development
APP_NAME=labena
LOG_CHANNELS=stderr
HTTP_ADDRESS=127.0.0.1:8080
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://demo:local-demo@127.0.0.1:55432/labena?sslmode=disable
QUEUE_REDIS_URL=redis://127.0.0.1:56379/1
EVENTS_DRIVER=gochannel
CACHE_DRIVER=disabled
FILESYSTEM_DISK=disabled
# Per-disk media defaults; direct URLs require public-read access only to public/*.
FILESYSTEM_MINIO_VISIBILITY=public
FILESYSTEM_MINIO_URL_MODE=internal
FILESYSTEM_MINIO_PUBLIC_URL=http://localhost:9000/uploads
MEDIA_BASE_URL=http://localhost:8080/api/v1/media
# Optional comma-separated disk names to open alongside the default.
FILESYSTEM_ADDITIONAL_DISKS=
AUTH_ENABLED=false
AUTH_PHONE_VERIFICATION_ENABLED=false
API_RATE_LIMIT_ENABLED=false
TRACING_ENABLED=false
METRICS_ENABLED=false

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=
MAIL_BRAND_NAME=
MAIL_ACCENT_COLOR="#1D4ED8"
MAIL_LOGO_URL=
MAIL_WEBSITE_URL=https://example.com
MAIL_SUPPORT_EMAIL=support@example.com
MAIL_FOOTER="Account updates, thoughtfully delivered."





PUSH_ENABLED=false
PUSH_EXPO_ACCESS_TOKEN=
PUSH_EXPO_PROJECT_ID=
